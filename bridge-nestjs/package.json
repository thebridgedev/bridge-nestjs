{
  "name": "@nebulr-group/bridge-nestjs",
  "version": "0.8.0",
  "description": "The Bridge for NestJS: token verification, flag-gated endpoints, plan limits and tenant data as a module, a guard and decorators.",
  "author": "Nebulr Group",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./flags": {
      "types": "./dist/flags/index.d.ts",
      "default": "./dist/flags/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "flags": [
        "dist/flags/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@nebulr-group/bridge-auth-core": "^0.8.0",
    "jose": "^5.2.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/testing": "^11.1.14",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "nestjs",
    "nest",
    "guard",
    "decorators",
    "jwt",
    "api-tokens",
    "the-bridge",
    "bridge",
    "authentication",
    "auth",
    "login",
    "sso",
    "feature-flags",
    "stripe",
    "subscriptions",
    "billing",
    "plan-limits",
    "multi-tenant",
    "rbac",
    "saas"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thebridgedev/bridge-nestjs"
  },
  "homepage": "https://thebridge.dev/docs/quickstart/nestjs/",
  "bugs": {
    "url": "https://github.com/thebridgedev/bridge-nestjs/issues"
  }
}
