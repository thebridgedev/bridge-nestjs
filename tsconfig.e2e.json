{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@nebulr-group/bridge-nestjs": [
        "bridge-nestjs/src"
      ],
      "*": [
        "bridge-nestjs/node_modules/*"
      ]
    },
    "typeRoots": [
      "bridge-nestjs/node_modules/@types"
    ],
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "e2e/**/*",
    "demo/src/**/*",
    "bridge-nestjs/src/**/*",
    "bridge-nestjs/test/support/**/*"
  ]
}
